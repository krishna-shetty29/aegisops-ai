DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_ai_devops
AUTOMATION_ENVIRONMENT=staging
ALLOW_AUTOMATED_STAGING_FIXES=false
ALLOW_PRODUCTION_CHANGES=false
# Database
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/autonomous_ai_devops

# Azure DevOps
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=replace-with-your-own-pat

# AI provider, if used
GEMINI_API_KEY=replace-with-your-own-key

# Browser origin allowed to call FastAPI
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Safety controls: keep all risky automation disabled
ALLOW_AI_BRANCH_CREATION=false
ALLOW_AI_PULL_REQUEST_CREATION=false
ALLOW_AUTOMATED_DEPLOYMENT=false
ALLOW_AUTOMATED_ROLLBACK=false
ALLOW_TERRAFORM=false
ALLOW_KUBERNETES_MUTATIONS=false
# Entra API identifiers
ENTRA_TENANT_ID=your-tenant-id
ENTRA_API_CLIENT_ID=your-api-client-id
AUTH_MODE=local
ENTRA_API_AUDIENCE=api://your-api-client-id
ENTRA_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
ENTRA_JWKS_URL=https://login.microsoftonline.com/your-tenant-id/discovery/v2.0/keys